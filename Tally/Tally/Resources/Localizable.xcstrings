{
  "sourceLanguage": "en",
  "strings": {
    "%@ is over budget by %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已超支 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已超支 %2$@"
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘 %@"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@"
          }
        }
      }
    },
    "%@/day · %lld days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天 %@ · 剩 %lld 天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天 %@ · 剩 %lld 天"
          }
        }
      }
    },
    "%@: %@ of budget used": {
      "localizations": {
        "zh-Hans": {
