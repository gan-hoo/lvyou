        }
      }
    },
    "The network is used only when you tap Download Today's Rates, which requests public reference rates from frankfurter.app. No ledger data is sent.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你轻点“下载今日汇率”时才会联网，从 frankfurter.app 获取公开参考汇率，不会发送任何账本数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你輕點“下載今日匯率”時纔會聯網，從 frankfurter.app 獲取公開參考匯率，不會發送任何帳本資料。"
