            "value": "淨額"
          }
        }
      }
    },
    "Net = income − expenses for this period (cash flow). Transfers, card repayments and balance adjustments are excluded; this is not the change in net worth.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净收支 = 本期收入 − 支出（现金流）。不含转账、信用卡还款和余额调整；它不等于净资产的变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淨收支 = 本期收入 − 支出（現金流）。不含轉帳、信用卡還款和餘額調整；它不等於淨資產的變化。"
          }
        }
      }
    },
    "Net Worth": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净资产"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淨資產"
          }
        }
      }
    },
    "Net worth with assets and liabilities, credit cards and loans, opening dates, reconciliation and audited balance adjustments.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净资产含资产与负债、信用卡与贷款、期初日期、对账和可追溯的余额调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淨資產含資產與負債、信用卡與貸款、期初日期、對帳和可追溯的餘額調整。"
          }
        }
      }
    },
