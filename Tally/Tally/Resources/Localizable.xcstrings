    "Add a limit for a category such as Dining or Shopping to track it separately.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为餐饮、购物等分类设定上限，单独跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為餐飲、購物等分類設定上限，單獨跟蹤。"
          }
        }
      }
    },
    "Add a note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加备注"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增備註"
          }
        }
      }
    },
    "Add a rate to convert this currency.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加汇率以换算此币种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增匯率以換算此幣種。"
          }
        }
      }
    },
    "Add at least two parts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要两项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要兩項。"
          }
        }
      }
    },
    "Add cash, cards, savings or debts to see where your money is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加现金、银行卡、储蓄或负债，看清钱在哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增現金、銀行卡、儲蓄或負債，看清錢在哪裡。"
          }
        }
      }
    },
    "Add on This Day": {
      "localizations": {
        "zh-Hans": {
