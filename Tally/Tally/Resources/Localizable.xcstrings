        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還款：減少欠款，不會再次計為支出。"
          }
        }
      }
    },
    "Repayment: reduces the amount owed; not counted as spending.": {
      "localizations": {
