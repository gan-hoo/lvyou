    "Tally is Locked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 已锁定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 已鎖定"
          }
        }
      }
    },
    "Tally is built only with Apple frameworks: SwiftUI, SwiftData, Swift Charts, LocalAuthentication, CryptoKit and Security. No third-party code is included in the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 仅使用 Apple 框架构建：SwiftUI、SwiftData、Swift Charts、LocalAuthentication、CryptoKit 和 Security。App 中不含第三方代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 僅使用 Apple 框架構建：SwiftUI、SwiftData、Swift Charts、LocalAuthentication、CryptoKit 和 Security。App 中不含第三方代碼。"
          }
        }
      }
    },
    "Tally keeps all data on this iPhone. Nothing is sent anywhere unless you export it or choose to download exchange rates.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 的所有数据都保存在这台 iPhone 上。除非你导出数据或主动下载汇率，否则不会发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 的所有資料都保存在這台 iPhone 上。除非你匯出資料或主動下載匯率，否則不會發送任何內容。"
          }
        }
      }
    },
    "Tally records balance adjustments, deletions, imports and restores so changes to your money can be traced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 会记录余额调整、删除、导入和恢复，让资金变动可以追溯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 會記錄餘額調整、刪除、匯入和恢復，讓資金變動可以追溯。"
          }
        }
      }
    },
    "Tap to record an expense, hold for more options": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点记一笔支出，长按查看更多选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點記一筆支出，長按查看更多選項"
          }
        }
      }
    },
