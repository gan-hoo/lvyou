      }
    },
    "Adjustments change only the account balance and are excluded from income and spending.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额调整只改变账户余额，不计入收入和支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額調整隻改變帳戶餘額，不計入收入和支出。"
          }
        }
      }
    },
