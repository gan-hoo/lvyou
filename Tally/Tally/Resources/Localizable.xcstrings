            "state": "translated",
            "value": "還款"
          }
        }
      }
    },
    "Repayment: lowers the amount owed. It is not counted as spending again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还款：减少欠款，不会再次计为支出。"
