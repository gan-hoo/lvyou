        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這天記一筆"
          }
        }
      }
    },
    "Add rent, salary, subscriptions or regular transfers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加房租、工资、订阅或定期转账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增房租、工資、訂閱或定期轉帳。"
          }
        }
      }
    },
    "Added %lld records, skipped %lld already in the ledger.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加 %lld 条记录，跳过 %lld 条已存在的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增 %lld 條記錄，跳過 %lld 條已存在的記錄。"
          }
        }
      }
    },
    "Adds sample accounts and about three months of transactions, all marked as demo.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加演示账户和约三个月的交易，均标记为演示数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增演示帳戶和約三個月的交易，均標記為演示資料。"
          }
        }
      }
    },
    "Adjustment recorded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录余额调整"
          }
        },
