        }
      }
    },
    "Due occurrences are booked automatically when Tally opens. Future occurrences never affect balances, and each occurrence is booked only once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到期的周期交易会在打开 Tally 时自动入账。未来的周期不会影响余额，每期只入账一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期的週期交易會在打開 Tally 時自動入帳。未來的週期不會影響餘額，每期只入帳一次。"
          }
        }
      }
    },
