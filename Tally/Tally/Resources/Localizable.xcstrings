    },
    "%lld items": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld items"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 笔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 筆"
          }
        }
      }
    },
    "%lld items need attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项需要处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 項需要處理"
          }
        }
      }
    },
    "%lld recurring transactions booked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已入账 %lld 笔周期交易"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已入帳 %lld 筆週期交易"
          }
        }
      }
    },
    "%lld rows were not imported:": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 行未导入："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 行未匯入："
          }
        }
      }
    },
    "%lld transactions are waiting for an exchange rate and are not counted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 笔交易等待汇率，未计入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 筆交易等待匯率，未計入。"
          }
        }
      }
    },
    "%lld transactions are waiting for an exchange rate and are not included.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 笔交易等待汇率，未计入统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 筆交易等待匯率，未計入統計。"
          }
        }
      }
    },
    "%lld transactions use this category.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 笔交易使用此分类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 筆交易使用此分類。"
          }
        }
      }
    },
    "1 unit = %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 单位 = %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 單位 = %@"
          }
        }
      }
    },
    "2 days ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前天"
          }
        }
      }
    },
    "A backup is one JSON file with every account, transaction, budget, recurring plan and exchange rate, plus a checksum. Save it to Files or iCloud Drive. Restoring shows what the file contains before anything changes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份是一个 JSON 文件，包含所有账户、交易、预算、周期计划和汇率，并带有校验值。可保存到“文件”或 iCloud 云盘。恢复前会先显示文件内容，确认后才会更改数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份是一個 JSON 檔案，包含所有帳戶、交易、預算、週期計劃和匯率，並帶有校驗值。可保存到“檔案”或 iCloud 雲碟。恢復前會先顯示檔案內容，確認後纔會更改資料。"
          }
        }
      }
    },
    "A budget with the same scope and period already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在相同范围和周期的预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在相同範圍和週期的預算。"
          }
        }
      }
    },
    "A calculator keypad and smart defaults keep everyday entries to two or three taps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算器键盘与智能默认值，日常记账只需两三步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算器鍵盤與智能預設值，日常記帳只需兩三步。"
          }
        }
      }
    },
    "A calm, precise ledger for everyday money.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静、精确的日常账本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜、精確的日常帳本。"
          }
        }
      }
    },
    "A limit for all spending in a month, week or year.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为一个月、一周或一年的全部支出设定上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為一個月、一週或一年的全部支出設定上限。"
          }
        }
      }
    },
    "A rate applies from its date until a newer one is added. Dates before the earliest rate use the earliest rate. Demo rates are approximate and are removed with the demo data.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇率从其生效日期起适用，直到添加更新的汇率。早于最早汇率的日期使用最早的汇率。演示汇率仅为近似值，会随演示数据一起删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率從其生效日期起適用，直到新增更新的匯率。早於最早匯率的日期使用最早的匯率。演示匯率僅為近似值，會隨演示資料一起刪除。"
          }
        }
      }
    },
