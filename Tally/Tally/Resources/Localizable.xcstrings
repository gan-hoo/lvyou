    "Tally is Locked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 已锁定"
          }
        }
      }
    },
    "Tally keeps all data on this iPhone. Nothing is sent anywhere unless you export it or choose to download exchange rates.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 的所有数据都保存在这台 iPhone 上。除非你导出数据或主动下载汇率，否则不会发送任何内容。"
          }
        }
      }
    },
    "Tally tracks it in real time and lets you know gently when you get close.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally 会实时追踪，并在接近额度时温和提醒。"
          }
        }
      }
    },
    "Tap + to record your first expense or income.": {
