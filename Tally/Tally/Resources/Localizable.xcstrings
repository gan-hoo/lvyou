    "2 days ago": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前天"
          }
        }
      }
    },
    "A calculator keypad and smart defaults keep everyday entries to two or three taps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算器键盘与智能默认值，日常记账只需两三步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算器鍵盤與智能預設值，日常記帳只需兩三步。"
          }
        }
      }
    },
    "A calm, precise ledger for everyday money.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静、精确的日常账本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜、精確的日常帳本。"
          }
        }
      }
    },
    "A rate applies from its date until a newer one is added. The default reference rate covers dates before your first entry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "汇率自生效日期起适用，直到添加新的汇率。默认参考汇率覆盖更早的日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯率自生效日期起適用，直到添加新的匯率。預設參考匯率覆蓋更早的日期。"
          }
        }
      }
    },
    "A single, quiet in-app reminder appears when spending reaches this share of the budget.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支出达到预算的此比例时，App 内会安静地提醒一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支出達到預算的此比例時，App 內會安靜地提醒一次。"
          }
        }
      }
    },
